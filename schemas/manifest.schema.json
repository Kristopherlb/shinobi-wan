{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kristopherlb/shinobi-wan/blob/main/schemas/manifest.schema.json",
  "title": "Shinobi Service Manifest",
  "description": "The YAML service manifest accepted by shinobi validate/plan/up. Mirrors ServiceManifest in @shinobi/cli.",
  "type": "object",
  "required": ["service", "components"],
  "additionalProperties": false,
  "properties": {
    "service": {
      "type": "string",
      "minLength": 1,
      "description": "Service name; used in stable IDs and stack naming."
    },
    "description": {
      "type": "string",
      "description": "Human-readable service description (informational; ignored by the compiler)."
    },
    "policyPack": {
      "type": "string",
      "enum": ["Baseline", "FedRAMP-Moderate", "FedRAMP-High"],
      "description": "Policy pack to evaluate against. May also be supplied via --policy-pack."
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component" }
    },
    "bindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/binding" }
    },
    "exceptions": {
      "type": "array",
      "description": "Policy rule exceptions (waivers) with mandatory expiry and justification.",
      "items": { "$ref": "#/$defs/exception" }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "required": ["id", "type", "platform"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique component identifier within the manifest."
        },
        "type": {
          "type": "string",
          "enum": ["component", "platform"],
          "description": "component = workload code you own; platform = managed resource."
        },
        "platform": {
          "type": "string",
          "pattern": "^aws-[a-z0-9-]+$",
          "description": "Platform node type, e.g. aws-lambda. See docs/user/support-matrix.md."
        },
        "config": {
          "type": "object",
          "description": "Platform-specific configuration properties."
        }
      }
    },
    "binding": {
      "type": "object",
      "required": ["source", "target", "type", "config"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["bindsTo", "triggers", "dependsOn", "contains"],
          "description": "Edge type. Compiled patterns: bindsTo (component→platform), triggers (platform→component), dependsOn (ordering). Others produce validation warnings."
        },
        "config": { "$ref": "#/$defs/bindingConfig" }
      }
    },
    "bindingConfig": {
      "type": "object",
      "required": ["resourceType"],
      "additionalProperties": true,
      "description": "resourceType is required; binders and lowerers may read additional platform-specific keys (e.g. route/method for API bindings).",
      "properties": {
        "resourceType": {
          "type": "string",
          "minLength": 1,
          "description": "Capability/resource type of the target, e.g. queue, topic, table."
        },
        "accessLevel": {
          "type": "string",
          "description": "Access level for IAM derivation, e.g. read, write, readwrite."
        },
        "actions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Explicit provider actions (overrides accessLevel derivation)."
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "protocol": { "type": "string", "enum": ["tcp", "udp", "any"] }
          }
        },
        "configKeys": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "valueSource"],
            "additionalProperties": false,
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "valueSource": { "$ref": "#/$defs/configValueSource" }
            }
          }
        }
      }
    },
    "configValueSource": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "value"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": ["literal", "static"],
              "description": "'literal' is canonical; 'static' is a tolerated alias used by some blueprints."
            },
            "value": { "type": ["string", "number", "boolean"] }
          }
        },
        {
          "type": "object",
          "required": ["type", "nodeRef"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "reference" },
            "nodeRef": { "type": "string", "minLength": 1 },
            "field": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["type", "secretRef"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "secret" },
            "secretRef": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "exception": {
      "type": "object",
      "required": ["ruleId", "target", "expires", "justification"],
      "additionalProperties": false,
      "properties": {
        "ruleId": {
          "type": "string",
          "minLength": 1,
          "description": "The policy rule being excepted, e.g. IAM-001."
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "description": "Component id the exception applies to, or * for service-wide."
        },
        "expires": {
          "type": "string",
          "format": "date",
          "description": "ISO date (YYYY-MM-DD) after which the exception no longer suppresses the rule."
        },
        "justification": {
          "type": "string",
          "minLength": 1,
          "description": "Why the exception is acceptable; recorded in policy output."
        },
        "approvedBy": {
          "type": "string",
          "description": "Optional approver identity for audit evidence."
        }
      }
    }
  }
}
